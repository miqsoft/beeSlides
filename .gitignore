# dependencies & build output.
# No trailing slash on node_modules: `node_modules/` matches DIRECTORIES only,
# so a node_modules SYMLINK (what you get pointing a worktree at another
# checkout's deps) slipped past it and was committed once. Match both forms.
node_modules
dist/
dist-single/
dist-viewer/

# local test decks — never committed (may contain confidential content)
testing/

# os cruft
.DS_Store
*.tsbuildinfo

working/

# secrets, matched by FILENAME anywhere in the tree, so moving a directory
# can never make one committable.
*.key
*.pem
.env
.env.*

# GIT WORKTREES CHECKED OUT INSIDE THE REPO. `.claude/` is a tracked directory
# (launch.json lives there), so a worktree under it is an entire second
# checkout sitting in `git status` — one broad `git add` sweeps thousands of
# files, including another branch's build output, into an unrelated commit.
#
# This was ignored only in `.git/info/exclude`, which is per-machine and never
# committed: it protected one laptop and nobody else's clone.
#
# It is NOT what deletes these directories — `git clean -fdx` reports "skip
# repository" for a nested checkout and needs `-ff` to touch one. Ignoring is
# about not COMMITTING them.
.claude/worktrees/

# per-session git worktrees (docs/PARALLEL-WORK.md §2.1). Inside the repo on
# purpose: ~/.zshrc picks the personal gh account by directory, and /tmp gets
# reaped — seven worktrees were lost from it in one day.
.worktrees/

# Local agent/harness config. Populated by tooling outside this repo; the repo
# itself ships none, so anything here is a working copy, not a shared contract.
.claude/agents
.claude/commands/team

# Personal Claude Code files (docs: add to .gitignore).
CLAUDE.local.md
.claude/settings.local.json

# docs site (site/): build output, Astro cache, the editor copied in at build
# time, and clip contact sheets for review (npm run clips -- --sheet).
site/.astro/
site/public/app/
site/.clips-review/
